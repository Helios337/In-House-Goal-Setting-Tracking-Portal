# General
NODE_ENV=development

# App ports
API_PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres
POSTGRES_DB=goal_portal
POSTGRES_USER=goal_user
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=

# API
API_IMAGE=ghcr.io/helios337/in-house-goal-tracking-api:latest
# Use a cryptographically secure value (recommended: at least 32 characters).
JWT_SECRET=GENERATE_STRONG_JWT_SECRET_HERE

# Web
WEB_IMAGE=ghcr.io/helios337/in-house-goal-tracking-web:latest
API_BASE_URL=http://api:4000
