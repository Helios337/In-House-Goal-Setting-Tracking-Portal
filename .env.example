# General
NODE_ENV=development

# App ports
API_PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres
POSTGRES_DB=goal_portal
POSTGRES_USER=goal_user
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Redis
REDIS_HOST=redis
# For local development only. Set a strong value for production deployments.
REDIS_PASSWORD=

# API
API_IMAGE=ghcr.io/helios337/in-house-goal-tracking-api:latest
# Use a cryptographically secure value (recommended: at least 32 characters, e.g. `openssl rand -base64 32`).
JWT_SECRET=REQUIRED_GENERATE_WITH_OPENSSL_RAND

# Web
WEB_IMAGE=ghcr.io/helios337/in-house-goal-tracking-web:latest
API_BASE_URL=http://api:4000
