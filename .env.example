# General
NODE_ENV=development

# App ports
API_PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres (used by Docker Compose and backend/scripts/migrate.sh)
POSTGRES_DB=goal_portal
POSTGRES_USER=goal_user
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Set a real password — must match the running Postgres container.
# If you change this after first `docker compose up`, run: docker compose down -v
POSTGRES_PASSWORD=CHANGE_ME

# Optional override (otherwise built from POSTGRES_* above)
# DATABASE_URL=postgresql://goal_user:yourpassword@localhost:5432/goal_portal

# Redis — host-native dev uses 127.0.0.1; Docker Compose api service overrides to redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Real-time / notifications
EMAIL_PROVIDER=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@goalportal.local
TEAMS_WEBHOOK_URL=
ESCALATION_SHEET_HOURS=48
ESCALATION_CHECKIN_HOURS=72

# Docker API startup (Compose entrypoint runs migrations; seed is optional)
# Set SEED_DATABASE=false after first deploy in production
SEED_DATABASE=true

# API
# Replace with your own registry image or a locally built image tag.
API_IMAGE=ghcr.io/helios337/in-house-goal-tracking-api:latest
# Use a cryptographically secure value (recommended: at least 32 characters, e.g. `openssl rand -base64 32`).
JWT_SECRET=CHANGE_ME

# Entra ID / Azure AD (backend token verification)
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
# Production: keep false. Dev-only: set true to allow /auth/sso without Entra id_token
ALLOW_INSECURE_SSO=false

# CORS — JSON array of browser origins allowed to call the API (include your internal web URL)
# Quote the JSON array so dotenv does not break pydantic parsing
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Web
# Replace with your own registry image or a locally built image tag.
WEB_IMAGE=ghcr.io/helios337/in-house-goal-tracking-web:latest
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Azure AD (Next.js — optional for password-only internal rollout)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
