# Browser calls /api/v1 on the Next server; this URL is the rewrite target (not exposed to the browser).
# Docker Compose: API_BASE_URL=http://api:8000
# Native dev (API on host port 4000): API_BASE_URL=http://127.0.0.1:4000
# Native dev (API on 8000): API_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:4000
# Optional: only needed for server-side code that bypasses the proxy
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-secret-change-in-production

# Azure AD (NextAuth provider — optional if using password login only)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Must match JWT_SECRET on the API in production (≥ 32 bytes)
# NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
